# Frontend Environment Variables Template
# Copy this file to .env for local development
# For production deployment, create .env.production

# ===== PUBLIC VARIABLES (exposed to browser via VITE_ prefix) =====

# Sanity Configuration
VITE_SANITY_PROJECT_ID=your-sanity-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Sanity Studio URL (for preview mode and CSP headers)
# Development: Auto-detected as http://localhost:3333
# Production: Set to your Cloud Run Studio URL
# Example: https://santan-studio-abc123-ew.a.run.app
VITE_SANITY_STUDIO_URL=

# ===== PRIVATE VARIABLES (server-side only, never exposed to browser) =====

# Sanity Read Token (for preview/draft mode)
# Get from: https://sanity.io/manage → API → Tokens
# Permissions: Viewer
SANITY_READ_TOKEN=your-sanity-read-token

# Session Secret (for preview mode sessions)
# Generate with: openssl rand -base64 32
SANITY_SESSION_SECRET=generate-a-long-random-secure-string-here

# ===== APPLICATION CONFIGURATION =====

# Node environment (set automatically in most cases)
NODE_ENV=development

# Server port (Cloud Run uses 8080)
PORT=8080


