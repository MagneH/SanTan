# Environment variables template for Google Cloud Run
# Copy this file to .env.production and fill in your actual values

# Sanity Configuration
VITE_SANITY_PROJECT_ID=your-sanity-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=your-sanity-read-token

# Preview/Draft mode (optional)
SANITY_API_WRITE_TOKEN=your-sanity-write-token

# Application Configuration
NODE_ENV=production
PORT=8080

# Session Secret (generate a secure random string)
SESSION_SECRET=generate-a-long-random-secure-string-here

# Optional: Add any other environment variables your app needs

