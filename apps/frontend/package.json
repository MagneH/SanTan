{
  "name": "@santan/frontend",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite dev --port 3000",
    "prebuild": "cd ../../packages/shared && npm run build",
    "build": "vite build",
    "build:cloudflare": "NODE_ENV=production vite build",
    "serve": "vite preview",
    "serve:cloudflare": "wrangler dev --config ../../wrangler.jsonc",
    "deploy:cloudflare": "wrangler deploy --config ../../wrangler.jsonc",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{css,less,sass,scss,html,md,graphql,gql,json,ts,tsx,js,jsx,yml,yaml}\"",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint",
    "clean": "rm -rf .output dist .turbo",
    "setup:preview-secret": "node scripts/create-preview-secret.js",
    "get:preview-secret": "node scripts/get-preview-secret.js",
    "cleanup:preview-secrets": "node scripts/cleanup-preview-secrets.js",
    "publish:preview-secret": "node scripts/publish-secret.js"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@emotion/unitless": "^0.10.0",
    "@portabletext/react": "^4.0.3",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/client": "^7.12.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^1.2.0",
    "@sanity/preview-url-secret": "^2.1.15",
    "@sanity/react-loader": "^2.0.0",
    "@sanity/ui": "^3.1.11",
    "@sanity/vision": "^4.13.0",
    "@sanity/visual-editing": "^2.4.1",
    "@santan/shared": "file:../../packages/shared",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/react-devtools": "^0.8.0",
    "@tanstack/react-query": "^5.90.6",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@tanstack/react-router": "^1.134.9",
    "@tanstack/react-router-devtools": "^1.134.9",
    "@tanstack/react-router-ssr-query": "^1.134.9",
    "@tanstack/react-start": "^1.134.10",
    "@tanstack/router-plugin": "^1.134.9",
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/css-utils": "^0.1.6",
    "@vanilla-extract/vite-plugin": "^5.1.1",
    "groq": "^4.13.0",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.552.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.9.5",
    "sanity": "^4.13.0",
    "tailwindcss": "^4.1.16",
    "tslib": "^2.8.1",
    "vite-tsconfig-paths": "^5.1.4",
    "xstate": "^5.24.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@netlify/vite-plugin-tanstack-start": "^1.1.8",
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/eslint-config": "^0.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.1.0",
    "lightningcss": "^1.27.0",
    "nitro": "^3.0.1-alpha.0",
    "prettier": "^3.5.3",
    "rollup": "^4.24.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.12",
    "vitest": "^4.0.6",
    "web-vitals": "^5.1.0",
    "wrangler": "^4.45.4"
  },
  "optionalDependencies": {
    "lightningcss-linux-arm64-musl": "^1.30.2",
    "lightningcss-linux-x64-gnu": "^1.30.2"
  }
}
