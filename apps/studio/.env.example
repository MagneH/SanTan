# Studio Environment Variables Template
# Copy this file to .env for local development

# ===== SANITY STUDIO CONFIGURATION =====
# These are used by projectDetails.ts and exposed to the Studio

# Sanity Project ID
SANITY_STUDIO_PROJECT_ID=your-project-id

# Sanity Dataset (production, staging, development, etc.)
SANITY_STUDIO_DATASET=production

# Sanity API Version (format: YYYY-MM-DD)
SANITY_STUDIO_API_VERSION=2024-01-01

# ===== FRONTEND INTEGRATION (for Presentation Tool) =====

# Frontend URL (where your frontend is hosted)
# Development: Auto-detected as http://localhost:3000
# Production: Set to your Cloud Run Frontend URL via deployment
# Example: https://santan-frontend-xyz123-ew.a.run.app
SANITY_STUDIO_FRONTEND_URL=

